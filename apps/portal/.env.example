# Public URL of the portal (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL of the BOV API (apps/api), used by the browser forms
NEXT_PUBLIC_API_URL=http://localhost:4000
# API address for server-side content requests and /media (defaults to NEXT_PUBLIC_API_URL)
API_URL=
# Shared with the API. Required in production: a long random string
REVALIDATE_SECRET=
