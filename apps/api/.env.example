PORT=4000
# Comma-separated origins allowed to call the API (the portal)
CORS_ORIGINS=http://localhost:3000
# Production Postgres (e.g. Neon). Leave empty locally: an embedded database is used in apps/api/data/db
DATABASE_URL=
# Portal address, called after content is published so pages refresh
PORTAL_URL=http://localhost:3000
# Shared with the portal. Required in production: a long random string
REVALIDATE_SECRET=
# true when the API runs behind a proxy / load balancer
TRUST_PROXY=false
