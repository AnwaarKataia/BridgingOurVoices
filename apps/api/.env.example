PORT=4000
# Comma-separated origins allowed to call the API (the portal)
CORS_ORIGINS=http://localhost:3000
# Production Postgres (e.g. Neon). Leave empty locally: an embedded database is used in apps/api/data/db
DATABASE_URL=
# Portal address, called after content is published so pages refresh
PORTAL_URL=http://localhost:3000
# Shared with the portal (page refresh after publishing + the team's preview links). Required in production: a long random string
REVALIDATE_SECRET=
# true when the API runs behind a proxy / load balancer
TRUST_PROXY=false
# Dashboard address, used in "forgot password" email links
DASHBOARD_URL=http://localhost:3002
# Outgoing email (password reset). Leave SMTP_HOST empty locally: emails are saved to apps/api/data/outbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the address, SMTP_PASS=an app password
# (Google account → Security → 2-Step Verification → App passwords). Never commit the real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bridging Our Voices <b.our.voices@gmail.com>
