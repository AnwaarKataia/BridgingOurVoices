{
    "name":  "@bov/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "db:generate":  "drizzle-kit generate",
                    "user:create":  "tsx src/scripts/create-user.ts"
                },
    "dependencies":  {
                         "@electric-sql/pglite":  "0.5.16",
                         "@fastify/cookie":  "11.1.5",
                         "@fastify/cors":  "^11.4.1",
                         "@fastify/multipart":  "^10.1.8",
                         "@fastify/rate-limit":  "11.2.2",
                         "drizzle-orm":  "0.45.4",
                         "fastify":  "^5.12.8",
                         "pg":  "8.23.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.6",
                            "@types/pg":  "8.23.1",
                            "drizzle-kit":  "0.31.11",
                            "tsx":  "^4.23.15",
                            "typescript":  "^7.0.2"
                        }
}